<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BoxPusher.MainPage"
             Title="Box Pusher">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20" RowSpacing="15">

        <!-- Move counter at the top -->
        <Label x:Name="MovesLabel"
               Grid.Row="0"
               Text="Moves: 0"
               FontSize="20"
               HorizontalOptions="Center" />

        <!-- The game grid gets built in code and dropped in here -->
        <Grid x:Name="BoardGrid"
              Grid.Row="1"
              HorizontalOptions="Center"
              VerticalOptions="Center" />

        <!-- Direction buttons at the bottom -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*,*"
              RowDefinitions="Auto,Auto,Auto"
              ColumnSpacing="10"
              RowSpacing="10">

            <Button Text="Up" Grid.Row="0" Grid.Column="1" Clicked="OnUpClicked" />
            <Button Text="Left" Grid.Row="1" Grid.Column="0" Clicked="OnLeftClicked" />
            <Button Text="Down" Grid.Row="1" Grid.Column="1" Clicked="OnDownClicked" />
            <Button Text="Right" Grid.Row="1" Grid.Column="2" Clicked="OnRightClicked" />

            <Button Text="Undo" Grid.Row="2" Grid.Column="0" Clicked="OnUndoClicked" />
            <Button Text="Reset" Grid.Row="2" Grid.Column="2" Clicked="OnResetClicked" />

        </Grid>

    </Grid>
</ContentPage>